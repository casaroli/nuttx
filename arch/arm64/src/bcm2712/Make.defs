include common/Make.defs

# bcm2712-specific C source files
CHIP_CSRCS  = bcm2712_boot.c bcm2712_serial.c

ifeq ($(CONFIG_ARCH_EARLY_PRINT),y)
CHIP_ASRCS  = bcm2712_lowputc.S
endif

ifeq ($(CONFIG_ARCH_USE_TEXT_HEAP),y)
CHIP_CSRCS += bcm2712_textheap.c
endif

ifeq ($(CONFIG_PM),y)
CHIP_CSRCS += bcm2712_initialize.c
endif
