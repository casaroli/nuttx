# A per-configuration Make.defs overrides the board's scripts/Make.defs
# entirely.  This is how every other BUILD_PROTECTED board in the tree selects
# its split linker scripts -- the board-level file is written for the flat
# build and hard-codes one memmap_*.ld, so a protected configuration cannot
# express itself there.  See boards/arm/lpc17xx_40xx/lpc4088-devkit/configs/
# knsh/Make.defs for the same pattern.

include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/tools/rp23xx/Config.mk
include $(TOPDIR)/arch/arm/src/armv8-m/Toolchain.defs

# memory.ld defines kflash/uflash/ksram/usram and the two scratch banks;
# kernel-space.ld places the kernel blob into the k* halves.  The user blob is
# linked separately by kernel/Makefile against memory.ld + user-space.ld.

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)memory.ld
ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)kernel-space.ld

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)$(DELIM)binfmt$(DELIM)libnxflat$(DELIM)gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048
